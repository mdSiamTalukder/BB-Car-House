# Base URL of the BB Car House Express API (server/).
# Used by server components, the admin session/proxy route handlers, and Proxy.
API_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Public dealer contact details (optional).
#
# The repository contains no verified business information, so these ship blank
# and the matching links are simply omitted until real values are provided.
# Never invent them — copy the real showroom details in here instead.
# ---------------------------------------------------------------------------
# Showroom phone number. Used for `tel:` links (Call Dealer, footer, contact page).
# An international format is recommended, e.g. +8801712345678
DEALER_PHONE=

# WhatsApp number in international format, digits only (no + or spaces),
# e.g. 8801712345678. Falls back to DEALER_PHONE when left blank.
DEALER_WHATSAPP=

# Public contact email used for `mailto:` links.
DEALER_EMAIL=

# Showroom address as displayed on the contact page and footer.
DEALER_ADDRESS=

# Google Maps directions/search link for the showroom (optional).
DEALER_MAP_URL=

# Canonical public origin used to build absolute car links in WhatsApp messages,
# e.g. https://bbcarhouse.com
SITE_URL=http://localhost:3000
